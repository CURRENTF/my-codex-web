{
  "name": "my-codex-web",
  "version": "0.1.0",
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "bin": { "codex-web": "./bin/codex-web.mjs" },
  "scripts": {
    "predev": "npm run build:packages",
    "dev": "concurrently -n server,web -c blue,green \"npm run dev -w @codex-web/server\" \"npm run dev -w @codex-web/web\"",
    "build:packages": "npm run build -w @codex-web/shared-types && npm run build -w @codex-web/codex-adapter",
    "build": "npm run build:packages && npm run build -w @codex-web/web && npm run build -w @codex-web/server",
    "build:release": "node scripts/build-release.mjs",
    "prepack": "npm run build && npm run build:release",
    "start": "node apps/server/dist/index.js",
    "check": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "test:live-smoke": "tsx scripts/live-v1-smoke.ts",
    "schema:generate": "node scripts/generate-schema.mjs",
    "schema:check": "node scripts/check-schema.mjs",
    "protocol:harness": "tsx scripts/protocol-harness.ts",
    "test:package": "node scripts/test-package.mjs"
  },
  "files": [".release/server.mjs", "apps/web/dist", "bin", "README.md", "THIRD_PARTY_NOTICES.md"],
  "dependencies": {
    "@fastify/cookie": "^11.0.0",
    "@fastify/multipart": "^9.2.1",
    "@fastify/static": "^10.1.2",
    "better-sqlite3": "^12.2.0",
    "fastify": "^5.5.0",
    "open": "^10.2.0",
    "pino": "^9.9.0",
    "ws": "^8.18.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.0.0",
    "concurrently": "^9.2.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "engines": { "node": ">=22.22.0" }
}
